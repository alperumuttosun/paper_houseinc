# =============================================================================
# STEP 07 - Robustness of the country rankings
# =============================================================================
# 07a. Leave-one-country-out: the partial scalar model is re-estimated without
#      each country in turn (full sample), latent means are re-estimated on the
#      stratified subsample (two-stage), and the ranks of the remaining seven
#      countries are compared with the main solution.
# 07b. Alternative anchor sets: (i) only the two energy-poverty items released,
#      (ii) the main set plus the next candidate item (FIN_COMF) released.

twostage_means <- function(partial_items, d_full, d_rep, label, model = inv_model,
                           levels = inv_levels$scalar) {
  part <- if (length(partial_items)) paste(partial_items, "~ 1") else ""
  res  <- fit_invariance(levels, d_full, partial = part, model = model)
  w <- res$warn
  if (!ok_fit(res$fit)) return(list(means = NULL, warn = w, route = res$route, route1 = res$route))
  w2 <- character(0)
  f2 <- withCallingHandlers(
    tryCatch(fixed_measurement_fit(res$fit, d_rep), error = function(e) e),
    warning = function(x) { w2 <<- c(w2, conditionMessage(x)); invokeRestart("muffleWarning") })
  if (inherits(f2, "error") || !ok_fit(f2)) {
    sm <- tryCatch(score_means(res$fit, d_rep, label), error = function(e) NULL)
    return(list(means = sm, warn = paste(c(w, w2), collapse = " | "),
                route = if (is.null(sm)) "failed" else "B_factor_scores", route1 = res$route))
  }
  list(means = latent_means(f2, label), warn = paste(c(w, unique(w2)), collapse = " | "),
       route = "A_fixed_parameters", route1 = res$route)
}

compare_ranks <- function(m_new, m_ref) {
  out <- list()
  for (fct in lv_names) {
    a <- m_new[m_new$factor == fct, c("country", "mean")]
    b <- m_ref[m_ref$factor == fct & m_ref$country %in% a$country, c("country", "mean")]
    ab <- merge(a, b, by = "country", suffixes = c("_new", "_ref"))
    ab$rank_new <- rank(-ab$mean_new, ties.method = "min")
    ab$rank_ref <- rank(-ab$mean_ref, ties.method = "min")
    out[[fct]] <- data.frame(factor = fct, ab[, c("country", "rank_ref", "rank_new")])
  }
  rbindlist(out)
}

step07_files <- c("step07_loco_ranks.csv", "step07_loco_summary.csv",
                  "step07_anchor_sensitivity.csv", "step07_warnings_log.csv")

