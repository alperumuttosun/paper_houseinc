  if (ok_fit(rm_fit$fit)) { fr <- fit_row(rm_fit$fit, "metric"); fr$route <- rm_fit$route; rows[["metric"]] <- fr }
  for (k in seq_along(steps)) {
    freed <- steps[seq_len(k)]; freed <- freed[nzchar(freed)]
    lab <- if (length(freed)) paste0("partial: ", paste(freed, collapse = " + ")) else "full scalar"
    r <- fit_partial_m(d9_full, inv_model, freed)
    if (!ok_fit(r$fit)) { rows[[lab]] <- data.frame(model = lab, route = "failed"); next }
    fr <- fit_row(r$fit, lab); fr$route <- r$route
    for (cmp in list(list(f = rm_fit$fit, nm = "vs_metric"), list(f = prev, nm = "vs_previous"))) {
      lrt <- if (ok_fit(cmp$f)) tryCatch(lavaan::lavTestLRT(r$fit, cmp$f), error = function(e) NULL) else NULL
      fr[[paste0("chisq_diff_", cmp$nm)]] <- if (is.null(lrt)) NA else round(lrt[2, "Chisq diff"], 3)
      fr[[paste0("df_diff_", cmp$nm)]]    <- if (is.null(lrt)) NA else lrt[2, "Df diff"]
      fr[[paste0("p_", cmp$nm)]]          <- if (is.null(lrt)) NA else signif(lrt[2, "Pr(>Chisq)"], 4)
    }
    fr$compared_with_previous <- prev_lab
    if (ok_fit(rm_fit$fit)) {
      fm0 <- lavaan::fitMeasures(rm_fit$fit)
      fr$delta_cfi_vs_metric   <- round(fr$cfi.scaled - fm0[["cfi.scaled"]], 4)
      fr$delta_rmsea_vs_metric <- round(fr$rmsea.scaled - fm0[["rmsea.scaled"]], 4)
      fr$delta_srmr_vs_metric  <- round(fr$srmr - fm0[["srmr"]], 4)
    }
    rows[[lab]] <- fr; prev <- r$fit; prev_lab <- lab
  }
  write_out(rbindlist(rows, fill = TRUE), f11b)
  log_run("11b", t0, "ok")
}

# -----------------------------------------------------------------------------
# 11c. Loadings of the items excluded during model building
# -----------------------------------------------------------------------------
# Each excluded item is added to the final two-factor model (with its three
# residual covariances), one at a time, in every country and in the pooled
# sample. Route A: WLSMV; route B: ULSMV.
f11c <- c("step11c_excluded_loadings.csv", "step11c_excluded_fit.csv")
if (!run_step11(f11c)) { message("Step 11c outputs found - skipped.") } else {
  message("Running step 11c ..."); t0 <- Sys.time()
  extra <- list(base = "",
                COMF_COOL = "AFFORD =~ COMF_COOL",
                LACK_ENERGY_APP_HEATING = "AFFORD =~ LACK_ENERGY_APP_HEATING",
                DP_MOULD3 = "DWELL =~ DP_MOULD3")
  all_items <- c(cfa_items, "COMF_COOL", "LACK_ENERGY_APP_HEATING", "DP_MOULD3")
  fit_one <- function(model, d) {
    warn <- character(0)
    run <- function(est) withCallingHandlers(
      tryCatch(lavaan::cfa(model, data = d, ordered = intersect(all_items, names(d)), estimator = est,
                           std.lv = TRUE, missing = "pairwise"), error = function(e) e),
      warning = function(w) { warn <<- c(warn, conditionMessage(w)); invokeRestart("muffleWarning") })
    conv <- function(f) !inherits(f, "error") && isTRUE(lavaan::lavInspect(f, "converged"))
    f <- run("WLSMV"); route <- "A_WLSMV"
    if (!conv(f)) { warn <- character(0); f <- run("ULSMV"); route <- "B_ULSMV" }
    if (!conv(f)) return(list(fit = NULL, route = "failed",
                              warn = if (inherits(f, "error")) conditionMessage(f) else "not converged"))
    list(fit = f, route = route, warn = paste(unique(warn), collapse = " | "))
  }
  ld_rows <- list(); fit_rows <- list()
  for (g in c(sort(unique(rec$country)), "POOLED")) {
    for (nm in names(extra)) {
      its <- if (nm == "base") cfa_items else c(cfa_items, nm)
      d <- rec[, c("country", its)]
      if (g != "POOLED") d <- d[d$country == g, ]
      d <- d[, its]
      n_endorsed <- if (nm == "base") NA else sum(d[[nm]] > 0, na.rm = TRUE)
      mdl <- if (nzchar(extra[[nm]])) paste(inv_model, extra[[nm]], sep = "\n") else inv_model
      r <- fit_one(mdl, d)
      key <- data.frame(country = g, variant = nm, n = nrow(d), n_endorsed_extra = n_endorsed,
                        route = r$route)
      if (is.null(r$fit)) { fit_rows[[length(fit_rows) + 1]] <- cbind(key, warnings = substr(r$warn, 1, 200)); next }
      fm <- lavaan::fitMeasures(r$fit)
      fit_rows[[length(fit_rows) + 1]] <- cbind(key, as.data.frame(as.list(round(fm[intersect(fit_names, names(fm))], 4))),
                                                warnings = substr(r$warn, 1, 200))
      ss <- lavaan::standardizedSolution(r$fit)
      ss <- ss[ss$op == "=~", c("lhs", "rhs", "est.std", "se")]
      ld_rows[[length(ld_rows) + 1]] <- cbind(key[, c("country", "variant", "route")], ss,
                                              excluded_item = ss$rhs == nm)
    }
  }
  ld <- rbindlist(ld_rows, fill = TRUE); ld[, `:=`(est.std = round(est.std, 3), se = round(se, 3))]
  write_out(ld, f11c[1])
  write_out(rbindlist(fit_rows, fill = TRUE), f11c[2])
  log_run("11c", t0, "ok")
}

