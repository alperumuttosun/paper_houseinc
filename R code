# TRUE when every listed output file is present in out_dir
outputs_exist <- function(files) all(file.exists(file.path(out_dir, files)))

# Write a UTF-8 CSV with BOM so that Excel opens it correctly
write_out <- function(x, file) fwrite(x, file.path(out_dir, file), bom = TRUE)

# Force valid UTF-8 strings; invalid bytes are re-read as latin1
fix_utf8 <- function(x) {
  x   <- enc2utf8(x)
  bad <- !is.na(x) & !validUTF8(x)
  x[bad] <- iconv(x[bad], from = "latin1", to = "UTF-8", sub = "?")
  x
}

# TRUE when the file exists and matches the published md5 checksum
md5_ok <- function(path, md5) file.exists(path) && unname(tools::md5sum(path)) == md5

# Map character responses to integer codes; unmapped values become NA
recode_map <- function(x, map) unname(map[trimws(as.character(x))])

# Upper triangle of a correlation matrix in long format
mat_to_long <- function(m) {
  idx <- which(upper.tri(m), arr.ind = TRUE)
  data.frame(item_i = rownames(m)[idx[, 1]],
             item_j = colnames(m)[idx[, 2]],
             r      = round(m[idx], 4))
}

