# -----------------------------------------------------------------------------
# 09e. Country-specific release of intercepts
# -----------------------------------------------------------------------------
# Intercepts of the released items are freed only in countries where the
# standardised EPC of the full scalar model exceeds `epc_release_cut`.
# Route A: edit the generated model syntax (free the intercept in the target
# groups); route B: edit the parameter table of the full scalar fit.
release_country_specific <- function(d, releases, model = inv_model) {
  glab <- sort(unique(d$country))
  ord  <- intersect(cfa_items, names(d))
  # Route A
  syn <- tryCatch(as.character(semTools::measEq.syntax(
    configural.model = model, data = d, ordered = ord, parameterization = "theta",
    ID.fac = "std.lv", ID.cat = "Wu.Estabrook.2016", group = "country",
    group.equal = inv_levels$scalar)), error = function(e) NULL)
  if (!is.null(syn)) {
    ln <- strsplit(syn, "\n", fixed = TRUE)[[1]]
    ok_edit <- TRUE
    for (it in unique(releases$item)) {
      i <- grep(paste0("^\\s*", it, "\\s*~\\s*c\\("), ln)
      i <- i[grepl("\\*\\s*1", ln[i])]
      if (length(i) != 1) { ok_edit <- FALSE; break }
      cs <- regmatches(ln[i], gregexpr("c\\([^)]*\\)", ln[i]))[[1]]
      parts <- lapply(cs, function(z) trimws(strsplit(sub("^c\\((.*)\\)$", "\\1", z), ",")[[1]]))
      if (length(parts) == 0 || any(lengths(parts) != length(glab))) { ok_edit <- FALSE; break }
      g <- match(releases$country[releases$item == it], glab)
      g <- g[!is.na(g) & g > 1]
      parts[[1]][g] <- "NA"                                   # free the intercept
      if (length(parts) > 1) parts[[2]][g] <- paste0(parts[[2]][g], ".free.g", g)  # break equality label
      terms <- vapply(parts, function(z) paste0("c(", paste(z, collapse = ", "), ")*1"), character(1))
      ln[i] <- paste0(it, " ~ ", paste(terms, collapse = " + "))
    }
    if (ok_edit) {
      f <- tryCatch(suppressWarnings(lavaan::cfa(paste(ln, collapse = "\n"), data = d, group = "country",
                                                 ordered = ord, parameterization = "theta",
                                                 estimator = "WLSMV", missing = "pairwise")),
                    error = function(e) NULL)
      if (ok_fit(f)) return(list(fit = f, route = "A_syntax"))
    }
  }
  # Route B
  rf <- fit_invariance(inv_levels$scalar, d, model = model)
  if (!ok_fit(rf$fit)) return(list(fit = NULL, route = "failed"))
  pt <- lavaan::parTable(rf$fit)
  gl <- lavaan::lavInspect(rf$fit, "group.label")
  for (k in seq_len(nrow(releases))) {
    g <- match(releases$country[k], gl); if (is.na(g) || g == 1) next
    r <- which(pt$op == "~1" & pt$lhs == releases$item[k] & pt$group == g)
    if (length(r) != 1) next
    if (pt$free[r] > 0 && nzchar(pt$plabel[r])) {
      pt <- pt[!(pt$op == "==" & (pt$lhs == pt$plabel[r] | pt$rhs == pt$plabel[r])), ]
      r <- which(pt$op == "~1" & pt$lhs == releases$item[k] & pt$group == g)
      pt$label[r] <- ""
    }
    if (pt$free[r] == 0) { pt$free[r] <- max(pt$free) + 1L; pt$ustart[r] <- NA }
  }
  fr <- pt$free > 0; pt$free[fr] <- match(pt$free[fr], sort(unique(pt$free[fr])))
  pt$ustart <- ifelse(pt$free == 0, pt$est, NA)
  keep <- c("id", "lhs", "op", "rhs", "user", "block", "group", "free", "ustart", "exo", "label", "plabel")
  pt <- as.data.frame(pt)[, intersect(keep, names(pt))]
  f <- tryCatch(suppressWarnings(lavaan::lavaan(pt, data = d, group = "country", group.label = gl,
                                                ordered = ord, parameterization = "theta",
                                                estimator = "WLSMV", missing = "pairwise")),
