# =============================================================================
# STEP 11 - Bootstrap convergence, fit of the partial models, excluded items
# =============================================================================
# 11b Fit of every partial scalar model on the release path (chi-square, df,
#     CFI, TLI, RMSEA, SRMR and scaled chi-square differences)
# 11c Country-specific loadings of the items excluded during model building
#     (cooling affordability, lacking heating equipment, third mould item)
# 11a Bootstrap repeating the intercept selection for the affordability factor
#     alone. The rare dwelling-defect categories caused most failed replicates
#     in step 10a; this run uses the same resamples (same seeds, same number of
#     replicates) without the dwelling-defect factor. Long run, resumable.

run_step11 <- function(files) force_rerun["step11"] || !outputs_exist(files)

afford11 <- c(cfa_energy, cfa_cost)
model_afford11 <- paste(lhs_rhs("AFFORD", afford11),
                        "RED_LIVING_COST_BORROW_MONEY ~~ RED_LIVING_COST_USE_CREDIT",
                        "FINBURDEN_ECOST ~~ FIN_BURD_HOUSECOST", sep = "\n")

# Partial scalar fit with the intercepts of `freed` released in all countries.
# Route A: measEq.syntax with group.partial; route B: syntax edit that frees
# the intercepts directly (the plain lavaan fallback cannot free them).
fit_partial_m <- function(d, model, freed) {
  part <- if (length(freed)) paste(freed, "~ 1") else ""
  r <- fit_invariance(inv_levels$scalar, d, partial = part, model = model)
  if (ok_fit(r$fit) && (length(freed) == 0 || identical(r$route, "A_measEq")))
    return(list(fit = r$fit, route = r$route))
  if (length(freed) == 0) return(list(fit = NULL, route = "failed"))
  rel <- expand.grid(item = freed, country = sort(unique(d$country))[-1], stringsAsFactors = FALSE)
  r2 <- release_country_specific(d, rel, model = model)
  list(fit = r2$fit, route = paste0("release_by_", r2$route))
}

# Release procedure of step 04 for any model and item set
select_partial_m <- function(d, model, items, max_iter = 8) {
  rm <- fit_invariance(inv_levels$metric, d, model = model)
  if (!ok_fit(rm$fit)) return(list(ok = FALSE, why = "metric"))
  ref <- fm_get(rm$fit)
  freed <- character(0); fits <- list(); iter <- 0; within <- FALSE; routes <- character(0)
  repeat {
    res <- fit_partial_m(d, model, freed)
    if (!ok_fit(res$fit)) return(list(ok = FALSE, why = paste0("scalar_iter_", iter)))
    fits[[as.character(iter)]] <- res$fit; routes <- c(routes, res$route)
    fm <- fm_get(res$fit)
    within <- (ref["cfi"] - fm["cfi"]) <= 0.010 && (fm["rmsea"] - ref["rmsea"]) <= 0.015
    if (within) break
    mi <- tryCatch(lavaan::modindices(res$fit, op = "~1", sort. = FALSE), error = function(e) NULL)
    if (is.null(mi) || nrow(mi) == 0) break
    mi <- as.data.table(mi[mi$lhs %in% setdiff(items, freed), c("lhs", "mi")])
    if (nrow(mi) == 0 || length(setdiff(items, freed)) <= 2) break
    agg <- mi[, .(X2 = sum(mi, na.rm = TRUE)), by = lhs]
    freed <- c(freed, agg$lhs[which.max(agg$X2)])
    iter <- iter + 1
    if (iter > max_iter) break
  }
  list(ok = TRUE, freed = freed, criteria_met = within, full = fits[["0"]],
       partial = fits[[length(fits)]], routes = paste(routes, collapse = ";"))
}

# Second-stage means. Route A: measurement parameters fixed at the full-sample
# estimates; route B: EBM factor scores of the full-sample model.
second_stage11 <- function(fit_full, d_new, label) {
  f2 <- tryCatch(suppressWarnings(fixed_measurement_fit(fit_full, d_new)), error = function(e) NULL)
  if (ok_fit(f2)) return(cbind(latent_means(f2, label), stage2 = "A_fixed_parameters"))
  sm <- tryCatch(suppressWarnings(score_means(fit_full, d_new, label)), error = function(e) NULL)
  if (!is.null(sm) && nrow(sm) > 0) return(cbind(sm, stage2 = "B_factor_scores"))
  NULL
}

