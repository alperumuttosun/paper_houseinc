# Download a file once; route A uses the Zenodo API link, route B the direct link
download_one <- function(key, md5) {
  dest <- file.path(data_dir, key)
  if (md5_ok(dest, md5)) return(TRUE)

  api_meta <- tryCatch(
    jsonlite::fromJSON(paste0("https://zenodo.org/api/records/", record_id),
                       simplifyVector = FALSE),
    error = function(e) NULL)
  if (!is.null(api_meta)) {
    hit <- Filter(function(f) identical(f$key, key), api_meta$files)
    if (length(hit) > 0) {
      try(download.file(hit[[1]]$links$self, dest, mode = "wb"), silent = TRUE)
      if (md5_ok(dest, md5)) return(TRUE)
    }
  }

  url_b <- paste0("https://zenodo.org/records/", record_id, "/files/", key, "?download=1")
  try(download.file(url_b, dest, mode = "wb"), silent = TRUE)
  if (md5_ok(dest, md5)) return(TRUE)

  warning("Download failed or checksum mismatch: ", key)
  FALSE
}

