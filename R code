theme_pub <- function(grey_panel = FALSE) {
  bg <- theme()
  if (grey_panel) bg <- theme(panel.background = element_rect(fill = "grey94", colour = NA),
                              panel.grid.major = element_line(colour = "white", linewidth = 0.35))
  theme_classic(base_size = 8, base_family = font_family) + bg +
    theme(axis.text = element_text(size = 8, colour = "black"),
          axis.title = element_text(size = 8),
          strip.text = element_text(size = 8, face = "bold", hjust = 0),
          strip.background = element_blank(),
          legend.text = element_text(size = 8), legend.title = element_text(size = 8),
          axis.line = element_line(linewidth = 0.35), axis.ticks = element_line(linewidth = 0.35),
          plot.margin = margin(3, 3, 3, 3, "mm"))
}

# Render to a temporary file first, then copy over the target. Cairo reports a
# failed write only as a warning, so warnings are captured and checked. A target
# that is open in a PDF/image viewer cannot be overwritten: this is reported.
render_device <- function(p, target, open_device) {
  tmp <- tempfile(fileext = paste0(".", tools::file_ext(target)))
  msgs <- character(0)
  ok <- withCallingHandlers(
    tryCatch({ open_device(tmp); print(p); grDevices::dev.off(); TRUE },
             error = function(e) { msgs <<- c(msgs, conditionMessage(e))
                                   try(grDevices::dev.off(), silent = TRUE); FALSE }),
    warning = function(w) { msgs <<- c(msgs, conditionMessage(w)); invokeRestart("muffleWarning") })
  if (!ok || !file.exists(tmp) || file.info(tmp)$size == 0 ||
      any(grepl("cairo error|error while writing", msgs))) return("render_failed")
  if (!isTRUE(file.copy(tmp, target, overwrite = TRUE))) return("target_locked")
  unlink(tmp)
  "ok"
}

save_figure <- function(p, name, width_mm, height_mm) {
  pdf_file  <- file.path(out_dir, paste0(name, ".pdf"))
  tiff_file <- file.path(out_dir, paste0(name, ".tiff"))
  w <- width_mm / 25.4; h <- height_mm / 25.4

  # PDF - route A: cairo_pdf (embedded fonts); route B: base pdf()
  pdf_route <- "A_cairo_pdf"
  st <- render_device(p, pdf_file, function(f) grDevices::cairo_pdf(f, width = w, height = h,
                                                                      family = font_family))
  if (st == "render_failed") {
    pdf_route <- "B_pdf"
    st <- render_device(p, pdf_file, function(f) grDevices::pdf(f, width = w, height = h,
                                                                 useDingbats = FALSE))
  }
  pdf_status <- st

  # TIFF 1200 dpi - route A: cairo; route B: default device type
  tiff_route <- "A_cairo_tiff"
  st <- render_device(p, tiff_file, function(f) grDevices::tiff(f, width = w, height = h, units = "in",
                                                                 res = 1200, compression = "lzw",
                                                                 type = "cairo"))
  if (st == "render_failed") {
    tiff_route <- "B_tiff"
    st <- render_device(p, tiff_file, function(f) grDevices::tiff(f, width = w, height = h, units = "in",
                                                                   res = 1200, compression = "lzw"))
  }
  tiff_status <- st

  if (pdf_status == "target_locked" || tiff_status == "target_locked")
    warning(name, ": output file is open in another program (close the PDF/TIFF viewer and re-run).",
            call. = FALSE)
  data.frame(figure = name, pdf_route = pdf_route, pdf_status = pdf_status,
             tiff_route = tiff_route, tiff_status = tiff_status,
             width_mm = width_mm, height_mm = height_mm, dpi = 1200)
}

