# -----------------------------------------------------------------------------
# 09h. Bootstrap of the two-stage procedure (long run, resumable)
# -----------------------------------------------------------------------------
# Respondents are resampled with replacement within each country from the full
# sample; each resampled respondent keeps its subsample flag. Both
# stages (partial scalar model on the resample; latent means on its
# stratified part) are re-estimated, so the uncertainty of the measurement
# parameters is carried into the latent means and ranks. Replicates are
# appended to the draws file one at a time; re-running continues the series.
f09h_draws <- "step09h_bootstrap_draws.csv"
f09h_fail  <- "step09h_bootstrap_failures.csv"
f09h_sum   <- c("step09h_bootstrap_summary.csv", "step09h_bootstrap_ranks.csv")
boot_path  <- file.path(out_dir, f09h_draws)
done_b <- if (file.exists(boot_path)) unique(fread(boot_path)$replicate) else integer(0)
if (file.exists(file.path(out_dir, f09h_fail)))
  done_b <- union(done_b, unique(fread(file.path(out_dir, f09h_fail))$replicate))
todo_b <- setdiff(seq_len(boot_B), done_b)

if (length(todo_b) == 0 && outputs_exist(f09h_sum)) {
  message("Step 09h complete - skipped.")
} else {
  message("Running step 09h: ", length(todo_b), " replicates to go (long run) ...")
  t0 <- Sys.time()
  idx_by_c <- split(seq_len(nrow(rec)), rec$country)
  for (b in todo_b) {
    if (as.numeric(difftime(Sys.time(), t0, units = "hours")) > boot_max_hours) {
      message("Time budget reached; re-run the script to continue the bootstrap."); break
    }
    set.seed(boot_seed + b)
    idx <- unlist(lapply(idx_by_c, function(ix) ix[sample.int(length(ix), length(ix), replace = TRUE)]),
                  use.names = FALSE)
    db <- rec[idx, ]
    dfull <- db[order(db$country), c("country", cfa_items)]
    drep  <- db[db$rep_sample %in% TRUE, c("country", cfa_items)]; drep <- drep[order(drep$country), ]
    r <- tryCatch(twostage_means(final_items, dfull, drep, "boot"),
                  error = function(e) list(means = NULL, route = "error", warn = conditionMessage(e)))
    # Accept only replicates estimated with the main routes (identification
    # route A for stage 1, fixed-parameter route A for stage 2)
    if (!is.null(r$means) && identical(r$route, "A_fixed_parameters") &&
        identical(r$route1, "A_measEq")) {
      x <- as.data.frame(r$means)[, c("factor", "country", "mean")]
      x <- data.frame(replicate = b, x)
      fwrite(x, boot_path, append = file.exists(boot_path))
    } else {
      fp <- file.path(out_dir, f09h_fail)
      fwrite(data.frame(replicate = b, route = paste(r$route1, r$route, sep = "/"),
                        note = substr(as.character(r$warn), 1, 300)), fp, append = file.exists(fp))
    }
    if (b %% 10 == 0) message("  bootstrap replicate ", b, " of ", boot_B, " (",
                              round(as.numeric(difftime(Sys.time(), t0, units = "hours")), 2), " h)")
  }

  # Summary (written whenever at least 20 replicates are available)
  if (file.exists(boot_path)) {
    bd <- fread(boot_path)
    nb <- length(unique(bd$replicate))
    if (nb >= 20) {
      bd <- bd[!(factor == "DWELL" & country %in% dwell_exclude)]
      main <- as.data.table(ref_main)[, .(factor, country, mean_main = mean, se_model = se)]
      sm <- bd[, .(n_replicates = .N, boot_mean = round(mean(mean), 4), boot_se = round(sd(mean), 4),
                   ci_lo = round(quantile(mean, 0.025), 4), ci_hi = round(quantile(mean, 0.975), 4)),
               by = .(factor, country)]
      sm <- merge(main, sm, by = c("factor", "country"))
      sm[, se_ratio_boot_to_model := ifelse(se_model > 0, round(boot_se / se_model, 2), NA_real_)]
      write_out(sm, f09h_sum[1])
      bd[, rank := frank(-mean, ties.method = "min"), by = .(replicate, factor)]
      rr <- bd[, .(rank_q025 = quantile(rank, 0.025), rank_median = median(rank),
                   rank_q975 = quantile(rank, 0.975), p_rank1 = round(mean(rank == 1), 3),
                   p_top3 = round(mean(rank <= 3), 3), n_replicates = .N), by = .(factor, country)]
      write_out(rr[order(factor, rank_median)], f09h_sum[2])
    }
  }
  log_run("09h", t0, paste0("replicates_total=", if (file.exists(boot_path))
    length(unique(fread(boot_path)$replicate)) else 0))
}


# =============================================================================
# STEP 10 - Selection uncertainty and further sensitivity analyses
# =============================================================================
# 10a Bootstrap in which the whole intercept-release procedure is repeated in
#     every replicate (selection stability; latent means and ranks under the
#     full scalar model and under the replicate's own partial scalar model).
#     Same resamples and the same number of replicates as step 09h.
#     Long run, resumable: replicates are appended one at a time.
# 10b Country-specific release with alternative |sEPC| cut-offs (0.15, 0.30)
# 10c One-stage partial scalar model estimated on the stratified subsample

# Release procedure used in step 04, applied to any data set. Intercept
# diagnostics come from modification indices (with Wu-Estabrook identification
# the equal intercepts carry no equality constraint, so score tests add nothing
# for them). Route A: modification indices of the current fit; route B: none
# available -> stop releasing (recorded).
select_partial <- function(d) {
  factor_of <- setNames(c(rep("DWELL", length(cfa_dwell)),
                          rep("AFFORD", length(c(cfa_energy, cfa_cost)))), cfa_items)
  rm <- fit_invariance(inv_levels$metric, d)
  if (!ok_fit(rm$fit) || !identical(rm$route, "A_measEq")) return(list(ok = FALSE, why = "metric"))
  ref <- fm_get(rm$fit)
  freed <- character(0); fits <- list(); iter <- 0; within <- FALSE
  repeat {
    res <- fit_invariance(inv_levels$scalar, d,
                          partial = if (length(freed)) paste(freed, "~ 1") else "")
    if (!ok_fit(res$fit) || !identical(res$route, "A_measEq"))
      return(list(ok = FALSE, why = paste0("scalar_iter_", iter)))
    fits[[as.character(iter)]] <- res$fit
    fm <- fm_get(res$fit)
    within <- (ref["cfi"] - fm["cfi"]) <= 0.010 && (fm["rmsea"] - ref["rmsea"]) <= 0.015
    if (within) break
    mi <- tryCatch(lavaan::modindices(res$fit, op = "~1", sort. = FALSE), error = function(e) NULL)
    if (is.null(mi) || nrow(mi) == 0) break
    mi <- as.data.table(mi[mi$lhs %in% setdiff(cfa_items, freed), c("lhs", "mi")])
    agg <- mi[, .(X2 = sum(mi, na.rm = TRUE)), by = lhs]
    remaining <- table(factor_of[setdiff(cfa_items, freed)])
    agg <- agg[as.vector(remaining[factor_of[agg$lhs]]) > 2]
    if (nrow(agg) == 0) break
    freed <- c(freed, agg$lhs[which.max(agg$X2)])
    iter <- iter + 1
    if (iter > 8) break
  }
  list(ok = TRUE, freed = freed, criteria_met = within, full = fits[["0"]],
       partial = fits[[length(fits)]])
}

