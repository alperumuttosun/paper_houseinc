# =============================================================================
# STEP 02 - Country-specific ordinal CFA of competing factor structures
# =============================================================================
# Item selection after step 01 diagnostics:
#   DP_MOULD3 dropped (one or zero endorsements in Finland)
#   COMF_COOL, LACK_ENERGY_APP_HEATING dropped (weak, inconsistent associations
#   with the affordability items)
# Nested structures (same 13 indicators):
#   M1 one factor  <  M2 dwelling + affordability  <  M3 dwelling + energy + cost
# Estimation: route A WLSMV, route B ULSMV; delta parameterisation; pairwise NA.

cfa_dwell  <- c("DP_LEAK", "DP_DAMP", "DP_ROT", "DP_MOULD1", "DP_MOULD2")
cfa_energy <- c("AFF_HEAT", "ARREARS", "FINBURDEN_ECOST")
cfa_cost   <- c("FIN_BURD_HOUSECOST", "FIN_COMF", "RED_LIVING_COST_LESS_FOOD",
                "RED_LIVING_COST_BORROW_MONEY", "RED_LIVING_COST_USE_CREDIT")
cfa_items  <- c(cfa_dwell, cfa_energy, cfa_cost)

lhs_rhs <- function(f, it) paste(f, "=~", paste(it, collapse = " + "))
cfa_models <- list(
  M1_one_factor   = lhs_rhs("DEPRIV", cfa_items),
  M2_two_factor   = paste(lhs_rhs("DWELL", cfa_dwell),
                          lhs_rhs("AFFORD", c(cfa_energy, cfa_cost)), sep = "\n"),
  M3_three_factor = paste(lhs_rhs("DWELL", cfa_dwell),
                          lhs_rhs("ENERGY", cfa_energy),
                          lhs_rhs("COST", cfa_cost), sep = "\n")
)

fit_names <- c("npar", "chisq.scaled", "df.scaled", "pvalue.scaled", "cfi.scaled",
               "tli.scaled", "rmsea.scaled", "rmsea.ci.lower.scaled",
               "rmsea.ci.upper.scaled", "srmr")

# Fit one model; collect warnings; fall back from WLSMV to ULSMV if needed
fit_cfa <- function(model, d) {
  converged <- function(f) !inherits(f, "error") && isTRUE(lavaan::lavInspect(f, "converged"))
  warn <- character(0)
  run <- function(est) withCallingHandlers(
    tryCatch(lavaan::cfa(model, data = d, ordered = cfa_items, estimator = est,
                         std.lv = TRUE, missing = "pairwise"),
             error = function(e) e),
    warning = function(w) { warn <<- c(warn, conditionMessage(w)); invokeRestart("muffleWarning") })
  f <- run("WLSMV"); route <- "A_WLSMV"
  if (!converged(f)) { warn <- character(0); f <- run("ULSMV"); route <- "B_ULSMV" }
  if (!converged(f)) {
    msg <- if (inherits(f, "error")) conditionMessage(f) else "not converged"
    return(list(fit = NULL, route = "failed", warn = msg))
  }
  list(fit = f, route = route, warn = paste(unique(warn), collapse = " | "))
}

step02_files <- c("step02_fit_by_country.csv", "step02_std_loadings.csv",
                  "step02_factor_correlations.csv", "step02_model_comparison.csv",
                  "step02_top_modindices.csv")

if (!force_rerun["step02"] && outputs_exist(step02_files)) {
  message("Step 02 outputs found - skipped.")
} else {
  message("Running step 02 ...")
  fit_tab <- list(); load_tab <- list(); cor_tab <- list(); cmp_tab <- list(); mi_tab <- list()
  groups <- c(sort(unique(rec$country)), "POOLED")

  for (smp in c("full", "representative")) {
    for (g in groups) {
      d <- rec
      if (smp == "representative") d <- d[d$rep_sample %in% TRUE, ]
      if (g != "POOLED") d <- d[d$country == g, ]
      d <- d[, cfa_items]
      fits <- list()

      for (m in names(cfa_models)) {
        res <- fit_cfa(cfa_models[[m]], d)
        key <- data.frame(sample = smp, country = g, model = m, n = nrow(d), route = res$route)
        if (is.null(res$fit)) {
          fit_tab[[length(fit_tab) + 1]] <- cbind(key, warnings = res$warn)
          next
        }
        fits[[m]] <- res$fit
        fm <- lavaan::fitMeasures(res$fit)
        fm <- as.list(round(fm[intersect(fit_names, names(fm))], 4))
        fit_tab[[length(fit_tab) + 1]] <- cbind(key, as.data.frame(fm), warnings = res$warn)

        ss <- lavaan::standardizedSolution(res$fit)
        ld <- ss[ss$op == "=~", c("lhs", "rhs", "est.std", "se", "pvalue")]
        load_tab[[length(load_tab) + 1]] <- cbind(key[, 1:3], ld)
        lv <- unique(ss$lhs[ss$op == "=~"])
        fc <- ss[ss$op == "~~" & ss$lhs != ss$rhs & ss$lhs %in% lv & ss$rhs %in% lv,
                 c("lhs", "rhs", "est.std", "se", "ci.lower", "ci.upper")]
        if (nrow(fc) > 0) cor_tab[[length(cor_tab) + 1]] <- cbind(key[, 1:3], fc)

        if (m != "M1_one_factor") {
          mi <- tryCatch(lavaan::modindices(res$fit, sort. = TRUE, maximum.number = 10),
                         error = function(e) NULL)
          if (!is.null(mi) && nrow(mi) > 0)
            mi_tab[[length(mi_tab) + 1]] <- cbind(key[, 1:3],
                                                  mi[, c("lhs", "op", "rhs", "mi", "sepc.all")])
        }
      }

      # Scaled chi-square difference tests between nested models
      pairs <- list(c("M1_one_factor", "M2_two_factor"), c("M2_two_factor", "M3_three_factor"))
      for (pr in pairs) {
        if (all(pr %in% names(fits))) {
          lrt <- tryCatch(lavaan::lavTestLRT(fits[[pr[1]]], fits[[pr[2]]]), error = function(e) NULL)
          if (!is.null(lrt)) cmp_tab[[length(cmp_tab) + 1]] <- data.frame(
            sample = smp, country = g, restricted = pr[1], general = pr[2],
            chisq_diff = round(lrt[2, "Chisq diff"], 3), df_diff = lrt[2, "Df diff"],
            p_value = signif(lrt[2, "Pr(>Chisq)"], 4))
        }
      }
    }
  }

  write_out(rbindlist(fit_tab, fill = TRUE), "step02_fit_by_country.csv")
  write_out(rbindlist(load_tab), "step02_std_loadings.csv")
  write_out(rbindlist(cor_tab),  "step02_factor_correlations.csv")
  write_out(rbindlist(cmp_tab),  "step02_model_comparison.csv")
  write_out(rbindlist(mi_tab),   "step02_top_modindices.csv")
}


# =============================================================================
# STEP 03 - Multi-group measurement invariance across countries
# =============================================================================
# Baseline: two-factor structure (DWELL, AFFORD) selected in step 02, plus three
# a-priori residual covariances motivated by item content:
#   borrowing ~ credit (same debt-coping block), the two "financial burden"
#   items (shared wording), the two mould items (shared content).
# Sequence (Wu & Estabrook, 2016): configural -> thresholds -> + loadings ->
#   + intercepts. Theta parameterisation, WLSMV, full sample.
# Route A: semTools::measEq.syntax identification; route B: lavaan group.equal.

inv_model <- paste(cfa_models$M2_two_factor,
                   "RED_LIVING_COST_BORROW_MONEY ~~ RED_LIVING_COST_USE_CREDIT",
                   "FINBURDEN_ECOST ~~ FIN_BURD_HOUSECOST",
                   "DP_MOULD1 ~~ DP_MOULD2", sep = "\n")

inv_levels <- list(configural = "",
                   thresholds = "thresholds",
                   metric     = c("thresholds", "loadings"),
                   scalar     = c("thresholds", "loadings", "intercepts"))

fit_invariance <- function(level_constraints, d, partial = "", model = inv_model) {
  ord  <- intersect(cfa_items, names(d))
  warn <- character(0)
  catch_warn <- function(w) { warn <<- c(warn, conditionMessage(w)); invokeRestart("muffleWarning") }
  converged  <- function(f) !inherits(f, "error") && isTRUE(lavaan::lavInspect(f, "converged"))

  f <- withCallingHandlers(tryCatch({
    syn <- semTools::measEq.syntax(configural.model = model, data = d,
                                   ordered = ord, parameterization = "theta",
                                   ID.fac = "std.lv", ID.cat = "Wu.Estabrook.2016",
                                   group = "country", group.equal = level_constraints,
                                   group.partial = partial)
    lavaan::cfa(as.character(syn), data = d, group = "country", ordered = ord,
                parameterization = "theta", estimator = "WLSMV", missing = "pairwise")
  }, error = function(e) e), warning = catch_warn)
  route <- "A_measEq"

  if (!converged(f)) {
    warn <- character(0)
    f <- withCallingHandlers(tryCatch(
      lavaan::cfa(model, data = d, group = "country", ordered = ord,
                  parameterization = "theta", estimator = "WLSMV", missing = "pairwise",
                  group.equal = level_constraints, group.partial = partial),
      error = function(e) e), warning = catch_warn)
    route <- "B_lavaan"
  }
  if (!converged(f)) {
    msg <- if (inherits(f, "error")) conditionMessage(f) else "not converged"
    return(list(fit = NULL, route = "failed", warn = msg))
  }
  list(fit = f, route = route, warn = paste(unique(warn), collapse = " | "))
}

