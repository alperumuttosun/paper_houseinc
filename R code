    loco[[cc]] <- data.frame(dropped = cc, compare_ranks(as.data.frame(r$means), ref))
  }
  loco_tab <- rbindlist(loco)
  write_out(loco_tab, "step07_loco_ranks.csv")
  if (nrow(loco_tab) > 0) {
    loco_sum <- loco_tab[, .(spearman = round(suppressWarnings(cor(rank_ref, rank_new,
                                                                   method = "spearman")), 3),
                             max_rank_shift = max(abs(rank_ref - rank_new)),
                             countries_changing_rank = sum(rank_ref != rank_new)),
                         by = .(dropped, factor)]
    write_out(loco_sum, "step07_loco_summary.csv")
  } else write_out(data.frame(note = "no successful fits"), "step07_loco_summary.csv")

  # 07b. Alternative anchor sets
  anchor_sets <- list(
    energy_items_only = intersect(c("AFF_HEAT", "FINBURDEN_ECOST"), cfa_items),
    main_plus_fin_comf = unique(c(final_items, "FIN_COMF")))
  anc <- list()
  for (nm in names(anchor_sets)) {
    r <- twostage_means(anchor_sets[[nm]], d_inv, d_rep, nm)
    warn_log[[nm]] <- data.frame(stage = nm, route = r$route, warnings = r$warn)
    if (is.null(r$means)) next
    cr <- compare_ranks(as.data.frame(r$means), ref)
    anc[[nm]] <- data.frame(anchor_set = nm,
                            released = paste(anchor_sets[[nm]], collapse = ";"),
                            merge(cr, as.data.frame(r$means)[, c("factor", "country", "mean", "se")],
                                  by = c("factor", "country")))
  }
  write_out(rbindlist(anc, fill = TRUE), "step07_anchor_sensitivity.csv")
  write_out(rbindlist(warn_log), "step07_warnings_log.csv")
}


# =============================================================================
# STEP 09 - Additional robustness analyses
# =============================================================================
# Every sub-step writes its own files and is skipped when they exist, so an
# interrupted run resumes where it stopped. The bootstrap (09h) appends one
# replicate at a time and continues from the last completed replicate.
# Ranks of the dwelling-defect factor exclude countries listed in
# `dwell_exclude`, whose latent mean is not identified.

run_log_file <- "step09_run_log.csv"
log_run <- function(sub, t_start, status, note = "") {
  row <- data.frame(substep = sub, started = format(t_start, "%Y-%m-%d %H:%M:%S"),
                    finished = format(Sys.time(), "%Y-%m-%d %H:%M:%S"),
                    minutes = round(as.numeric(difftime(Sys.time(), t_start, units = "mins")), 1),
                    status = status, note = note)
  fwrite(row, file.path(out_dir, run_log_file), append = file.exists(file.path(out_dir, run_log_file)),
         bom = !file.exists(file.path(out_dir, run_log_file)))
}

# Ranks with non-identified dwelling-defect means removed
rank_excl <- function(m) {
  m <- as.data.table(m)
  m <- m[!(factor == "DWELL" & country %in% dwell_exclude)]
  m[, rank := frank(-mean, ties.method = "min"), by = .(method, factor)]
  m[]
}

# Spearman correlation and rank shifts of a solution against the main solution
compare_to_main <- function(m_new, m_ref, label) {
  a <- rank_excl(m_new)[, .(factor, country, rank_new = rank, mean_new = mean, se_new = se)]
  b <- rank_excl(m_ref)[, .(factor, country, rank_ref = rank, mean_ref = mean)]
  ab <- merge(a, b, by = c("factor", "country"))
  ab[, rank_new := frank(-mean_new, ties.method = "min"), by = factor]
  ab[, rank_ref := frank(-mean_ref, ties.method = "min"), by = factor]
  summ <- ab[, .(spearman = round(suppressWarnings(cor(rank_ref, rank_new, method = "spearman")), 3),
                 max_rank_shift = max(abs(rank_ref - rank_new)),
                 countries_changing_rank = sum(rank_ref != rank_new)), by = factor]
  list(detail = data.frame(analysis = label, ab), summary = data.frame(analysis = label, summ))
}

fit_row <- function(f, label) {
  fm <- lavaan::fitMeasures(f)
  cbind(data.frame(model = label), as.data.frame(as.list(round(fm[intersect(fit_names, names(fm))], 4))))
}

