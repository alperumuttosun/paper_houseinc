if (!force_rerun["step04"] && outputs_exist(step04_files)) {
  message("Step 04 outputs found - skipped.")
} else {
  message("Running step 04 (several model refits; may take a while) ...")
  inv_fit_tab <- fread(file.path(out_dir, "step03_invariance_fit.csv"))
  ref_cfi   <- inv_fit_tab[level == "metric", cfi.scaled]
  ref_rmsea <- inv_fit_tab[level == "metric", rmsea.scaled]

  d_inv <- rec[, c("country", cfa_items)]; d_inv$country <- as.character(d_inv$country)
  d_rep <- rec[rec$rep_sample %in% TRUE, c("country", cfa_items)]
  d_rep$country <- as.character(d_rep$country)
  warn_log <- list()

  # 04a/04b. Sequential release of intercept constraints
  factor_of <- setNames(c(rep("DWELL", length(cfa_dwell)),
                          rep("AFFORD", length(c(cfa_energy, cfa_cost)))), cfa_items)
  freed <- character(0); final_partial <- character(0); path <- list(); iter <- 0
  repeat {
    res <- fit_invariance(inv_levels$scalar, d_inv,
                          partial = if (length(freed)) paste(freed, "~ 1") else "")
    warn_log[[length(warn_log) + 1]] <- data.frame(stage = paste0("partial_iter_", iter),
                                                   route = res$route, warnings = res$warn)
    if (!ok_fit(res$fit)) break
    fm <- fm_get(res$fit)
    sc <- tryCatch(score_table(res$fit), error = function(e) NULL)
    if (iter == 0 && !is.null(sc)) write_out(sc, "step04_score_tests_scalar.csv")

    within <- (ref_cfi - fm["cfi"]) <= 0.010 && (fm["rmsea"] - ref_rmsea) <= 0.015
    path[[length(path) + 1]] <- data.frame(
      iteration = iter, freed_items = paste(freed, collapse = ";"), route = res$route,
      cfi = round(fm["cfi"], 4), rmsea = round(fm["rmsea"], 4),
      delta_cfi_vs_metric = round(fm["cfi"] - ref_cfi, 4),
      delta_rmsea_vs_metric = round(fm["rmsea"] - ref_rmsea, 4),
      criteria_met = within)
    final_partial <- freed
    if (within || is.null(sc)) break

    # Candidate items: intercept constraints, factor must keep >= 2 constrained items
    cand <- sc[!is.na(sc$item) & sc$op == "~1" & sc$item %in% setdiff(cfa_items, freed), ]
    if (nrow(cand) == 0) { message("No intercept diagnostics available - stopping release."); break }
    agg  <- cand[, .(X2 = sum(stat, na.rm = TRUE)), by = item]
    remaining <- table(factor_of[setdiff(cfa_items, freed)])
    agg <- agg[as.vector(remaining[factor_of[agg$item]]) > 2]
    if (nrow(agg) == 0) break
    freed <- c(freed, agg$item[which.max(agg$X2)])
    iter <- iter + 1
  }
  write_out(rbindlist(path), "step04_partial_path.csv")

  # 04c. Country means on the stratified subsample
  means <- list()

  # Observed composite: mean of pooled z-scores, expressed relative to the first country
  ref_country <- sort(unique(d_rep$country))[1]
  for (fct in c("DWELL", "AFFORD")) {
    its <- names(factor_of)[factor_of == fct]
    z <- scale(as.matrix(d_rep[, its]))
    comp <- rowMeans(z, na.rm = TRUE)
    cm <- tapply(comp, d_rep$country, mean, na.rm = TRUE)
    sdp <- sd(comp, na.rm = TRUE)
    means[[length(means) + 1]] <- data.frame(
      method = "observed_composite", factor = fct, country = names(cm),
      mean = round((cm - cm[ref_country]) / sdp, 4), se = NA_real_)
  }

  for (spec in list(list(lab = "scalar_full", part = ""),
                    list(lab = "scalar_partial",
                         part = if (length(final_partial)) paste(final_partial, "~ 1") else ""))) {
    res <- fit_invariance(inv_levels$scalar, d_rep, partial = spec$part)
    warn_log[[length(warn_log) + 1]] <- data.frame(stage = paste0("rep_", spec$lab),
                                                   route = res$route, warnings = res$warn)
    if (ok_fit(res$fit)) means[[length(means) + 1]] <- latent_means(res$fit, spec$lab)
  }

  mt <- rbindlist(means)
  mt[, rank := frank(-mean, ties.method = "min"), by = .(method, factor)]
  write_out(mt, "step04_country_means.csv")

  # Rank agreement between approaches
  rk <- dcast(mt, factor + country ~ method, value.var = "rank")
  meth <- setdiff(names(rk), c("factor", "country"))
  cmp <- list()
  for (fct in unique(rk$factor)) for (i in seq_along(meth)) for (j in seq_along(meth)) if (i < j) {
    a <- rk[factor == fct][[meth[i]]]; b <- rk[factor == fct][[meth[j]]]
    cmp[[length(cmp) + 1]] <- data.frame(
      factor = fct, method_a = meth[i], method_b = meth[j],
      spearman = round(suppressWarnings(cor(a, b, method = "spearman", use = "complete.obs")), 3),
      max_rank_shift = suppressWarnings(max(abs(a - b), na.rm = TRUE)),
      countries_changing_rank = sum(a != b, na.rm = TRUE))
  }
  write_out(rbindlist(cmp), "step04_rank_comparison.csv")
  write_out(rbindlist(warn_log), "step04_warnings_log.csv")
}


# =============================================================================
# STEP 05 - Two-stage latent means on the stratified subsample
# =============================================================================
# Measurement parameters (loadings, thresholds, intercepts, residual (co)variances)
# are estimated on the full sample and held fixed; only factor means, variances
# and covariances are estimated on the stratified subsample. This avoids the
# weak identification of binary-indicator thresholds in sparse country cells.
# Route A: fixed-parameter re-estimation; route B: EBM factor scores.

lv_names <- c("DWELL", "AFFORD")

fixed_measurement_fit <- function(fit_full, d_new, equal_var = FALSE) {
  pt   <- lavaan::parTable(fit_full)
  glab <- lavaan::lavInspect(fit_full, "group.label")
  pt   <- pt[pt$op != "==", ]
  structural <- (pt$op == "~~" & pt$lhs %in% lv_names & pt$rhs %in% lv_names) |
                (pt$op == "~1" & pt$lhs %in% lv_names)
  meas <- !structural & pt$op %in% c("=~", "|", "~~", "~1", "~*~")
  pt$ustart <- ifelse(pt$free == 0 | meas, pt$est, NA)
  pt$free[meas] <- 0L
  if (equal_var) {
    vrow <- pt$op == "~~" & pt$lhs == pt$rhs & pt$lhs %in% lv_names
    pt$free[vrow] <- 0L; pt$ustart[vrow] <- 1
  }
  pt$free[pt$free > 0] <- seq_len(sum(pt$free > 0))
  pt$label <- ""
  keep <- c("id", "lhs", "op", "rhs", "user", "block", "group", "free", "ustart", "exo", "label")
  pt <- as.data.frame(pt)[, intersect(keep, names(pt))]
  lavaan::lavaan(pt, data = d_new, group = "country", group.label = glab,
                 ordered = cfa_items, parameterization = "theta",
                 estimator = "WLSMV", missing = "pairwise")
}

score_means <- function(fit_full, d_new, label) {
  glab <- lavaan::lavInspect(fit_full, "group.label")
  fs <- lavaan::lavPredict(fit_full, newdata = d_new, method = "EBM")
  if (!is.list(fs)) fs <- list(fs)
  out <- rbindlist(lapply(seq_along(fs), function(g) {
    m <- colMeans(fs[[g]], na.rm = TRUE)
    data.frame(country = glab[g], factor = names(m), mean = unname(m))
  }))
  out[, mean := mean - mean[country == glab[1]], by = factor]
  data.frame(method = label, factor = out$factor, country = out$country,
             mean = round(out$mean, 4), se = NA_real_)
}

