# -----------------------------------------------------------------------------
# 09b. Invariance between the stratified subsample and the remaining respondents
# -----------------------------------------------------------------------------
# Within each country, a two-group model (stratified subsample vs remaining
# respondents) is tested from configural to scalar. Equality supports applying
# full-sample measurement parameters to the stratified subsample.
# Route A: two-factor model; route B: affordability items only (used when the
# dwelling-defect items are too sparse in one of the two parts).
f09b <- c("step09b_sample_invariance_fit.csv", "step09b_sample_invariance_tests.csv")
if (!run_step09(f09b)) { message("Step 09b outputs found - skipped.") } else {
  message("Running step 09b ..."); t0 <- Sys.time()
  afford_items <- c(cfa_energy, cfa_cost)
  model_afford <- paste(lhs_rhs("AFFORD", afford_items),
                        "RED_LIVING_COST_BORROW_MONEY ~~ RED_LIVING_COST_USE_CREDIT",
                        "FINBURDEN_ECOST ~~ FIN_BURD_HOUSECOST", sep = "\n")
  fits_b <- list(); tests_b <- list()
  for (cc in sort(unique(rec$country))) {
    dd <- rec[rec$country == cc, c("rep_sample", cfa_items)]
    dd$country <- ifelse(dd$rep_sample %in% TRUE, "representative", "oversample")
    dd <- dd[order(dd$country), c("country", cfa_items)]
    run_levels <- function(mdl, dsub) {
      out <- list()
      for (lv in names(inv_levels)) {
        r <- fit_invariance(inv_levels[[lv]], dsub, model = mdl)
        if (!ok_fit(r$fit)) return(NULL)
        out[[lv]] <- fit_row(r$fit, lv)
      }
      out
    }
    route <- "A_two_factor"
    lv_fit <- run_levels(inv_model, dd)
    if (is.null(lv_fit)) {
      route <- "B_affordability_only"
      lv_fit <- run_levels(model_afford, dd[, c("country", afford_items)])
    }
    if (is.null(lv_fit)) { fits_b[[cc]] <- data.frame(country = cc, route = "failed"); next }
    if (length(lv_fit) == 0) next
    ft <- rbindlist(lv_fit, fill = TRUE)
    fits_b[[cc]] <- data.frame(country = cc, route = route, ft)
    for (k in seq_len(nrow(ft))[-1]) tests_b[[paste(cc, k)]] <- data.frame(
      country = cc, route = route, restricted = ft$model[k], general = ft$model[k - 1],
      delta_cfi = round(ft$cfi.scaled[k] - ft$cfi.scaled[k - 1], 4),
      delta_rmsea = round(ft$rmsea.scaled[k] - ft$rmsea.scaled[k - 1], 4),
      criteria_met = (ft$cfi.scaled[k - 1] - ft$cfi.scaled[k]) <= 0.010 &&
                     (ft$rmsea.scaled[k] - ft$rmsea.scaled[k - 1]) <= 0.015)
  }
  write_out(rbindlist(fits_b, fill = TRUE), f09b[1])
  write_out(rbindlist(tests_b, fill = TRUE), f09b[2])
  log_run("09b", t0, ifelse(length(fits_b) > 0, "ok", "failed"))
}

# -----------------------------------------------------------------------------
# 09c. District heating and item functioning (MIMIC models)
# -----------------------------------------------------------------------------
# District heating = HEAT_SRC code 7; code 13 ("don't know") = missing.
# (i)  share of district-heated households by country
# (ii) per country: AFFORD regressed on district heating, with direct effects of
#      district heating on the heating-affordability and energy-cost items
#      (a direct effect indicates different item functioning by heating type)
# (iii) pooled: country dummies with direct effects on the two items, estimated
#      without (model A) and with (model B) district-heating direct effects; the
#      change in Finland's direct effect shows how much district heating accounts
#      for its item-level deviation.
# Route A: WLSMV; route B: ULSMV.
f09c <- c("step09c_district_heating_share.csv", "step09c_mimic_by_country.csv",
          "step09c_mimic_pooled.csv")
if (!run_step09(f09c)) { message("Step 09c outputs found - skipped.") } else {
  message("Running step 09c ..."); t0 <- Sys.time()
  hs <- suppressWarnings(as.integer(as.character(hi$HEAT_SRC)))
  rec$dh <- ifelse(is.na(hs) | hs == 13L, NA_integer_, as.integer(hs == 7L))

  share_tab <- function(dt) dt[, .(n = .N, n_valid = sum(!is.na(dh)),
                                    n_district = sum(dh == 1, na.rm = TRUE),
                                    pct_district = round(100 * mean(dh, na.rm = TRUE), 2)), by = country]
  sh  <- data.table(sample = "full", share_tab(as.data.table(rec)))
  sh2 <- data.table(sample = "representative", share_tab(as.data.table(rec)[rep_sample %in% TRUE]))
  write_out(rbind(sh, sh2)[order(sample, country)], f09c[1])

  afford_items <- c(cfa_energy, cfa_cost)
  meas_afford <- paste(lhs_rhs("AFFORD", afford_items),
                       "RED_LIVING_COST_BORROW_MONEY ~~ RED_LIVING_COST_USE_CREDIT",
                       "FINBURDEN_ECOST ~~ FIN_BURD_HOUSECOST", sep = "\n")
  fit_sem2 <- function(model, d, ord) {
    run <- function(est) tryCatch(suppressWarnings(
      lavaan::sem(model, data = d, ordered = ord, estimator = est, std.lv = TRUE)),
      error = function(e) NULL)
    f <- run("WLSMV"); route <- "A_WLSMV"
    if (!ok_fit(f)) { f <- run("ULSMV"); route <- "B_ULSMV" }
    list(fit = f, route = route)
  }
  pick <- function(f, rows) {
    ss <- lavaan::standardizedSolution(f, type = "std.all")
    ss <- ss[ss$op == "~", c("lhs", "op", "rhs", "est.std", "se", "pvalue", "ci.lower", "ci.upper")]
    pe <- lavaan::parameterEstimates(f)[, c("lhs", "op", "rhs", "est")]
    merge(pe[pe$op == "~", ], ss, by = c("lhs", "op", "rhs"))
  }

  # (ii) per country
  by_c <- list()
  for (cc in sort(unique(rec$country))) {
    dd <- rec[rec$country == cc & !is.na(rec$dh), c("dh", afford_items)]
    if (sum(dd$dh == 1) < 30 || sum(dd$dh == 0) < 30) {
      by_c[[cc]] <- data.frame(country = cc, route = "skipped_too_few_district_heated",
                               n = nrow(dd), n_district = sum(dd$dh == 1)); next
    }
    mdl <- paste(meas_afford, "AFFORD ~ dh", "AFF_HEAT ~ dh", "FINBURDEN_ECOST ~ dh", sep = "\n")
    r <- fit_sem2(mdl, dd, afford_items)
    if (is.null(r$fit)) { by_c[[cc]] <- data.frame(country = cc, route = "failed"); next }
    by_c[[cc]] <- data.frame(country = cc, route = r$route, n = nrow(dd),
                             n_district = sum(dd$dh == 1), pick(r$fit))
  }
  write_out(rbindlist(by_c, fill = TRUE), f09c[2])

  # (iii) pooled with country dummies (Belgium = reference)
  dd <- rec[!is.na(rec$dh), c("country", "dh", afford_items)]
  cs <- setdiff(sort(unique(dd$country)), sort(unique(dd$country))[1])
  for (cc in cs) dd[[paste0("c_", cc)]] <- as.integer(dd$country == cc)
  dum <- paste0("c_", cs)
  base <- paste(meas_afford,
                paste("AFFORD ~", paste(c("dh", dum), collapse = " + ")),
                paste("AFF_HEAT ~", paste(dum, collapse = " + ")),
                paste("FINBURDEN_ECOST ~", paste(dum, collapse = " + ")), sep = "\n")
  mods <- list(A_without_dh_direct = base,
               B_with_dh_direct = paste(base, "AFF_HEAT ~ dh", "FINBURDEN_ECOST ~ dh", sep = "\n"))
  pooled <- list()
  for (nm in names(mods)) {
    r <- fit_sem2(mods[[nm]], dd[, c("dh", dum, afford_items)], afford_items)
    if (is.null(r$fit)) { pooled[[nm]] <- data.frame(model = nm, route = "failed"); next }
    pooled[[nm]] <- data.frame(model = nm, route = r$route, n = nrow(dd), pick(r$fit),
                               cfi = round(lavaan::fitMeasures(r$fit)["cfi.scaled"], 4),
                               rmsea = round(lavaan::fitMeasures(r$fit)["rmsea.scaled"], 4))
  }
  write_out(rbindlist(pooled, fill = TRUE), f09c[3])
  log_run("09c", t0, "ok")
}

