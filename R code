# =============================================================================
# STEP 06 - Sensitivity to factor-variance specification and rank uncertainty
# =============================================================================
# 06a. Two-stage latent means re-estimated with factor variances fixed to 1 in
#      every country (identifies the mean when a country is near the floor of a
#      binary-indicator factor)
# 06b. Rank uncertainty: 10,000 draws from the asymptotic sampling distribution
#      of the latent means; 95% rank intervals and probabilities of top ranks.
#      Route A: lavaan sampling covariance; route B: independent normal draws
#      using standard errors only.

rank_uncertainty <- function(f, label, n_draw = 10000, seed = 20251117, exclude = list()) {
  pt   <- lavaan::parTable(f)
  glab <- lavaan::lavInspect(f, "group.label")
  out  <- list()
  for (fct in lv_names) {
    rows <- which(pt$op == "~1" & pt$lhs == fct)
    if (!is.null(exclude[[fct]])) rows <- rows[!glab[pt$group[rows]] %in% exclude[[fct]]]
    est  <- setNames(pt$est[rows], glab[pt$group[rows]])
    free_idx <- pt$free[rows]
    draws <- matrix(rep(est, each = n_draw), nrow = n_draw, dimnames = list(NULL, names(est)))
    set.seed(seed)
    V <- tryCatch(lavaan::lavInspect(f, "vcov"), error = function(e) NULL)
    k <- free_idx > 0
    route <- "A_vcov"
    if (!is.null(V) && sum(k) > 0) {
      Vk <- as.matrix(V)[free_idx[k], free_idx[k], drop = FALSE]
      draws[, k] <- MASS::mvrnorm(n_draw, mu = est[k], Sigma = Vk)
    } else {
      se <- pt$se[rows]
      draws[, k] <- sapply(which(k), function(j) rnorm(n_draw, est[j], se[j]))
      route <- "B_independent"
    }
    rk <- t(apply(-draws, 1, rank, ties.method = "min"))
    out[[fct]] <- data.frame(
      method = label, factor = fct, country = names(est), route = route,
      rank_point  = rank(-est, ties.method = "min"),
      rank_q025   = apply(rk, 2, quantile, 0.025),
      rank_median = apply(rk, 2, median),
      rank_q975   = apply(rk, 2, quantile, 0.975),
      p_rank1     = round(colMeans(rk == 1), 3),
      p_top3      = round(colMeans(rk <= 3), 3))
  }
  rbindlist(out)
}

