# =============================================================================
# STEP 04 - Partial scalar invariance and comparison of country means
# =============================================================================
# 04a. Univariate score tests for every equality constraint of the scalar model
# 04b. Item-level release of intercept constraints, one item at a time (largest
#      summed score statistic first) until the partial scalar model is within
#      Delta CFI <= .010 and Delta RMSEA <= .015 of the metric model, keeping at
#      least two fully constrained indicators per factor
# 04c. Country means on the stratified subsample under three approaches:
#      observed composite, full scalar model, final partial scalar model

# Diagnostics for the scalar model: (i) score tests of equality constraints and
# (ii) modification indices for intercepts that are fixed by the identification
# (with Wu-Estabrook identification, equal intercepts are fixed to zero, so they
# carry no equality constraint and appear only in the modification indices)
score_table <- function(fit) {
  glab <- lavaan::lavInspect(fit, "group.label")
  pt   <- lavaan::parTable(fit)
  out  <- list()
  st <- tryCatch(lavaan::lavTestScore(fit, univariate = TRUE, cumulative = FALSE,
                                      epc = FALSE)$uni, error = function(e) NULL)
  if (!is.null(st) && nrow(st) > 0) {
    i1 <- match(st$lhs, pt$plabel); i2 <- match(st$rhs, pt$plabel)
    out$score <- data.frame(source = "score_test", item = pt$lhs[i1], op = pt$op[i1],
                            param = pt$rhs[i1], country = glab[pt$group[i2]],
                            stat = round(st$X2, 3), epc = NA_real_)
  }
  mi <- tryCatch(lavaan::modindices(fit, op = "~1", sort. = FALSE), error = function(e) NULL)
  if (!is.null(mi) && nrow(mi) > 0) {
    mi <- mi[mi$lhs %in% cfa_items, ]
    grp <- if ("group" %in% names(mi)) mi$group else mi$block
    out$mi <- data.frame(source = "mod_index", item = mi$lhs, op = mi$op, param = "",
                         country = glab[grp], stat = round(mi$mi, 3),
                         epc = round(mi$sepc.all, 3))
  }
  if (length(out) == 0) return(NULL)
  rbindlist(out, fill = TRUE)
}

ok_fit <- function(f) !is.null(f) && isTRUE(lavaan::lavInspect(f, "converged"))
fm_get <- function(f) { fm <- lavaan::fitMeasures(f); c(cfi = unname(fm["cfi.scaled"]),
                                                     rmsea = unname(fm["rmsea.scaled"])) }

# Latent factor means and standard errors by country
latent_means <- function(f, label) {
  pe <- lavaan::parameterEstimates(f)
  glab <- lavaan::lavInspect(f, "group.label")
  m <- pe[pe$op == "~1" & pe$lhs %in% c("DWELL", "AFFORD"), c("lhs", "group", "est", "se")]
  data.frame(method = label, factor = m$lhs, country = glab[m$group],
             mean = round(m$est, 4), se = round(m$se, 4))
}

step04_files <- c("step04_score_tests_scalar.csv", "step04_partial_path.csv",
