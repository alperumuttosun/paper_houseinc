if (!run_step12(f12a)) { message("Step 12a outputs found - skipped.") } else {
  message("Running step 12a ..."); t0 <- Sys.time()
  fits12 <- list(full_scalar = fit_partial_m(d9_full, inv_model, character(0)),
                 partial_main = fit_partial_m(d9_full, inv_model, main_freed12))
  diag12 <- list(); tot12 <- list()
  for (nm in names(fits12)) {
    f <- fits12[[nm]]$fit
    if (!ok_fit(f)) { diag12[[nm]] <- data.table(model = nm, note = "not converged"); next }
    st <- score_table(f)
    if (is.null(st)) { diag12[[nm]] <- data.table(model = nm, note = "no diagnostics"); next }
    st <- as.data.table(st)[source == "mod_index"]
    st[, model := nm][, route := fits12[[nm]]$route]
    diag12[[nm]] <- st[, .(model, route, item, country, mi = stat, sepc = epc)]
    # Total modification index per item = the quantity used by the release rule
    tt <- st[!(item %in% if (nm == "partial_main") main_freed12 else character(0)),
             .(total_mi = round(sum(stat, na.rm = TRUE), 1),
               max_abs_sepc = round(max(abs(epc), na.rm = TRUE), 3),
               country_max = country[which.max(abs(epc))]), by = item]
    tt[, model := nm][, rank_next := frank(-total_mi, ties.method = "min")]
    tot12[[nm]] <- tt[order(rank_next)]
  }
  write_out(rbindlist(diag12, fill = TRUE), f12a[1])
  write_out(rbindlist(tot12, fill = TRUE), f12a[2])
  log_run("12a", t0, "ok")
}

